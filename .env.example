# Copy to .env for local runs (never commit .env). On Render, set these in
# the dashboard under Environment instead.

# Required — Neon Postgres connection string (free tier, no card).
# Example: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Local test alternative (no Neon needed): in-process Postgres, data stored
# in ./.pglite-data next to the repo. DO NOT use for the real deployment.
# DATABASE_URL=pglite://./.pglite-data

# Owner login for the standalone copy. The browser asks for these once and
# remembers them. In production the server refuses to start without
# OWNER_PASS — set both on Render.
OWNER_USER=owner
OWNER_PASS=

# Optional — Google Gemini API key (free tier from Google AI Studio, no
# card). Switches on the AI features: producer extraction, artist-name
# cleaning, album-folder naming, hum-to-search. Without it the app uses its
# built-in fallbacks and everything else works the same.
GEMINI_API_KEY=

# Optional — override the YouTube web-client key (the app already carries
# YouTube's public web key; only set this if YouTube ever rotates it).
# YOUTUBE_API_KEY=

# Port for local runs (Render sets PORT itself).
PORT=3000

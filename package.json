{
  "dependencies": {
    "@tanstack/react-query": "5.100.10",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "2.15.3",
    "zod": "4.4.3",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.10",
    "@types/bun": "1.4.2",
    "@types/pg": "8.11.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "bun-plugin-tailwind": "0.0.15",
    "tailwindcss": "4.1.13",
    "tailwindcss-safe-area": "1.3.0",
    "typescript": "5.6.3"
  },
  "name": "sm-life-streaming-standalone",
  "packageManager": "bun@1.3.10",
  "private": true,
  "scripts": {
    "build": "bun run build:server && bun run build:client",
    "build:client": "bun ./client/build.mjs",
    "build:server": "bun build ./server/src/server.ts --target=bun --outfile=./server/dist/server.js --external @electric-sql/pglite",
    "dev": "bun --watch ./server/src/server.ts",
    "migrate": "bun ./scripts/migrate.ts",
    "start": "bun ./server/dist/server.js",
    "typecheck": "bun x tsc --noEmit -p client/tsconfig.json && bun x tsc --noEmit -p server/tsconfig.json"
  },
  "type": "module"
}